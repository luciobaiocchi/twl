# Fake but recognizable keys: if any of these strings shows up anywhere in
# the agent's domain, INV-SECRET is broken.
OPENAI_API_KEY=sk-CANARY-REAL-KEY-MUST-NOT-LEAK-0123456789
ANTHROPIC_API_KEY=sk-ant-CANARY-REAL-KEY-MUST-NOT-LEAK-0123456789

# Not declared in capshell.yaml: passes through to the child unchanged.
DATABASE_URL=postgres://localhost/dev
