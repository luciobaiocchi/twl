# Replace the documentation-only TEST-NET CIDRs with the exact egress ranges
# for the authorized HTTPS upstreams before applying this policy. NetworkPolicy
# applies to the whole Pod, not separately to the Towel and agent containers.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: coding-agent-with-towel
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/component: towel-session
  policyTypes:
    - Ingress
    - Egress
  ingress: []
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - ipBlock:
            cidr: 192.0.2.0/24
        - ipBlock:
            cidr: 2001:db8::/32
      ports:
        - protocol: TCP
          port: 443
